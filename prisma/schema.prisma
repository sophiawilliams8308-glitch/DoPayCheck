// DoPayCheck — Prisma schema
//
// PHASE 2: Rule & Data System.
//
// This schema is the authoritative data architecture for tax rules. It is built around four
// invariants taken from the Master Specification (docs/SPECIFICATION.md §2, §18–§23):
//
//   1. Tax values are DATA, never code. A new tax year is new rows, not a new release.
//   2. Rules are VERSIONED and EFFECTIVE-DATED. `taxYear` alone never decides which rule
//      applies — effective dates are first-class and authoritative.
//   3. Published history is IMMUTABLE. Corrections supersede; they never overwrite.
//   4. Every authoritative value is SOURCE-TRACEABLE and carries a verification status.
//
// NAMING: Prisma's default identifier mapping is used (PascalCase tables, camelCase columns).
// Raw SQL in migrations therefore quotes identifiers. This keeps the ORM the single access
// path and avoids a large surface of hand-written @map annotations that could silently drift.
//
// DECIMAL PRECISION: authoritative numeric values use NUMERIC(28,12) — see TaxRuleValue.
//
// NOT_STATED IS NEVER ZERO: every authoritative numeric column is NULLABLE. A missing value
// is stored as NULL with a verification status, never coerced to 0 (spec §19).

generator client {
  provider = "prisma-client-js"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// ENUMS
// ===========================================================================

/// Levels of taxing authority. Spec §9 — ZIP code alone is never a jurisdiction.
enum JurisdictionType {
  FEDERAL
  STATE
  COUNTY
  CITY
  LOCALITY
  SCHOOL_DISTRICT
  OTHER
}

/// Lifecycle of a tax year container (spec §23).
enum TaxYearStatus {
  DRAFT
  PREPARATION
  ACTIVE
  CLOSED
  ARCHIVED
}

/// Rule categories (spec §20). Strongly typed so category strings are never scattered.
enum RuleCategory {
  FEDERAL_INCOME_TAX
  FEDERAL_WITHHOLDING
  SOCIAL_SECURITY
  MEDICARE
  /// Phase 4 (spec D-FUTA-1). FUTA's structure — a gross rate reduced by a
  /// credit, over its own wage base — has no analogue in FIT (schedules) or
  /// FICA (symmetric rate + base), and it is the only federal tax whose
  /// effective rate depends on the state of employment. Filing it under
  /// SOCIAL_SECURITY would bury it for the administrators who maintain it.
  FUTA
  STATE_INCOME_TAX
  STATE_WITHHOLDING
  DISABILITY_SDI
  PAID_LEAVE
  SUTA
  MINIMUM_WAGE
  OVERTIME
  RECIPROCITY
  LOCAL_TAX
}

/// Rule lifecycle (spec §18). A rule must never reach ACTIVE without verification+approval.
enum RuleStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  SUPERSEDED
  REJECTED
  ROLLED_BACK
  BLOCKED
}

/// Verification status (spec §19).
///
/// NOT_APPLICABLE and NOT_STATED are deliberately distinct:
///   NOT_APPLICABLE — the rule/component genuinely does not apply.
///   NOT_STATED     — the official source does not state a value.
/// Neither may ever be converted to zero.
enum VerificationStatus {
  VERIFIED
  NOT_APPLICABLE
  PENDING
  CONFLICT
  PARTIALLY_VERIFIED
  NOT_STATED
}

/// Kind of official document a source represents (spec §21).
enum SourceType {
  STATUTE
  REGULATION
  PUBLICATION
  FORM
  INSTRUCTIONS
  BULLETIN
  NOTICE
  WEBPAGE
  DATASET
  OTHER
}

/// Sources are archived, never destructively deleted once referenced (spec §29).
enum SourceStatus {
  ACTIVE
  ARCHIVED
  SUPERSEDED
}

/// Conflicting sources must be representable without silent resolution (spec §24).
enum ConflictStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  ACCEPTED_AMBIGUITY
  DISMISSED
}

/// Auditable actions (spec §31). Audit records are append-only.
enum AuditAction {
  CREATE
  EDIT
  DUPLICATE
  APPROVE
  REJECT
  PUBLISH
  ROLLBACK
  ARCHIVE
  RESTORE
  DELETE
  RESET
  IMPORT
  EXPORT
}

/// Pay frequencies enumerated by spec §11. These are product-defined structural values,
/// not tax values, so an enum is appropriate.
enum PayFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  QUARTERLY
  ANNUAL
  DAILY
}

/// Semantic type of a stored authoritative value, so consumers never guess units.
enum ValueType {
  RATE
  PERCENT
  MONEY
  MULTIPLIER
  COUNT
  DURATION_DAYS
  BOOLEAN
  TEXT
}

// ===========================================================================
// JURISDICTIONS
// ===========================================================================

/// A taxing jurisdiction: federal, state, county, city or other local authority.
///
/// Hierarchical via self-relation so locality resolution (Phase 6) can walk ancestors.
/// ZIP codes are deliberately NOT modelled as jurisdictions — a ZIP is at best an input aid
/// to resolution, never the legal authority (spec §9).
model Jurisdiction {
  id   String           @id @default(cuid())
  /// Stable machine identifier, e.g. "US", "US-CA", "US-PA-PHILADELPHIA".
  code String           @unique
  /// URL-safe identifier used by public routes, e.g. "california" (spec §35/§36).
  slug String           @unique
  name String
  type JurisdictionType

  parentId String?
  parent   Jurisdiction?  @relation("JurisdictionHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Jurisdiction[] @relation("JurisdictionHierarchy")

  /// Denormalized two-letter state code for fast filtering of sub-state jurisdictions.
  stateCode String?
  /// Census FIPS code where one exists. Reference data, not tax data.
  fipsCode  String?

  /// Jurisdictions are deactivated, never destructively deleted once referenced (spec §29).
  isActive      Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  notes    String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxRules TaxRule[]
  sources  Source[]

  localTaxRules      LocalTaxRule[]
  reciprocityFrom    ReciprocityRule[] @relation("ReciprocityFrom")
  reciprocityTo      ReciprocityRule[] @relation("ReciprocityTo")

  /// SEO-04 (SEO-03 contract §AE): additive back-relations only. This model's own semantics,
  /// columns and indexes are unchanged — the SEO domain reads this table, never writes it.
  seoPages                   SeoPage[]
  taxDataReadinessApprovals  TaxDataReadinessApproval[]

  @@index([type])
  @@index([parentId])
  @@index([stateCode])
  @@index([isActive])
}

// ===========================================================================
// TAX YEARS
// ===========================================================================

/// A tax year container. Any year is representable; nothing is hardcoded to 2026.
///
/// A tax year groups rules for administration and reporting. It does NOT decide which rule
/// version applies at a point in time — effective dates do (spec §23).
model TaxYear {
  id     Int           @id @default(autoincrement())
  year   Int           @unique
  status TaxYearStatus @default(DRAFT)

  /// Period the tax year covers. Usually the calendar year, but stored explicitly rather
  /// than assumed so non-calendar periods remain representable.
  startDate DateTime
  endDate   DateTime

  /// At most one tax year may be flagged default; enforced by a partial unique index.
  /// (Renamed from `isCurrent` in the Phase 2 extension; the column is renamed in place so
  /// existing rows are preserved.)
  isDefault Boolean @default(false)

  notes    String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxRules TaxRule[]
  sources  Source[]

  /// SEO-04 (SEO-03 contract §AE): additive back-relation only, same rule as `Jurisdiction`.
  taxDataReadinessApprovals TaxDataReadinessApproval[]

  @@index([status])
  @@index([isDefault])
}

// ===========================================================================
// SOURCES
// ===========================================================================

/// An official document that authorises tax rule data (spec §21).
///
/// Sources are never invented. A rule without a verified source must not reach ACTIVE.
model Source {
  id           String     @id @default(cuid())
  /// Stable human-usable identifier, e.g. "IRS-PUB-15-T-2026".
  code         String     @unique
  /// Issuing agency or organisation, e.g. "Internal Revenue Service".
  organization String
  title        String
  sourceType   SourceType

  /// Official URL. NEVER fabricated — null when not yet recorded.
  url             String?
  publicationDate DateTime?
  effectiveDate   DateTime?
  /// Revision/edition identifier printed on the document, when it has one.
  documentVersion String?

  /// Jurisdiction the document is issued by / applies to, when it is jurisdiction-specific.
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  /// Tax year the document governs, when it is year-specific.
  taxYearId      Int?
  taxYear        TaxYear?      @relation(fields: [taxYearId], references: [id], onDelete: Restrict)

  /// Document-level verification state. Precise per-rule locators and their own verification
  /// live on `TaxRuleSource`, because one document supports many rules at different locations.
  verificationStatus VerificationStatus @default(PENDING)

  notes  String?
  status SourceStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleSources     TaxRuleSource[]
  conflictsAsA    RuleConflict[]  @relation("ConflictSourceA")
  conflictsAsB    RuleConflict[]  @relation("ConflictSourceB")

  /// Direct traces from individual brackets and withholding tables to this document.
  brackets          TaxBracket[]
  withholdingTables WithholdingTable[]

  @@index([organization])
  @@index([sourceType])
  @@index([status])
  @@index([jurisdictionId])
  @@index([taxYearId])
}

// ===========================================================================
// TAX RULES
// ===========================================================================

/// A single versioned, effective-dated tax rule for one jurisdiction and category.
///
/// VERSIONING MODEL
///   `ruleKey` identifies the CONCEPTUAL rule (stable across versions and years).
///   `version` increments for each new record sharing that key.
///   A correction creates a NEW row and marks the previous one SUPERSEDED — published rows
///   are never rewritten (spec §23, §29).
///
/// RESOLUTION
///   The applicable rule is chosen by jurisdiction + category + effective date + lifecycle
///   status. `taxYearId` is for administration and reporting, never the deciding factor.
model TaxRule {
  id      String @id @default(cuid())
  /// Stable conceptual identifier shared by every version of this rule.
  ruleKey String
  version Int    @default(1)

  taxYearId      Int
  taxYear        TaxYear      @relation(fields: [taxYearId], references: [id], onDelete: Restrict)
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)

  category    RuleCategory
  /// Optional finer classification within a category, e.g. a specific programme or table
  /// family. Free text because the taxonomy is jurisdiction-specific and must stay data.
  subcategory String?
  /// Primary shape of this rule's authoritative value, when it has a single dominant one.
  /// Null for composite rules (bracket sets, withholding tables).
  valueType   ValueType?
  name        String
  description String?

  /// Scenario matching for Phase 3+ (e.g. filing status, pay frequency, residency).
  /// Structure is validated in the domain layer, not guessed here.
  applicability Json?
  conditions    Json?
  exceptions    Json?

  /// Category-specific structured payload (brackets, tables, formulas).
  /// NULL while PENDING DATA — an absent payload is never an empty object of zeros.
  payload              Json?
  /// Schema version of `payload`, so payload shapes can evolve without data loss.
  payloadSchemaVersion Int   @default(1)

  /// AUTHORITATIVE. Effective dates decide applicability, not `taxYear`.
  effectiveFrom DateTime
  /// NULL means open-ended (still in force).
  effectiveTo   DateTime?

  status             RuleStatus         @default(DRAFT)
  verificationStatus VerificationStatus @default(PENDING)

  /// Links a correction to the version it replaces, preserving history.
  supersedesId String?  @unique
  supersedes   TaxRule? @relation("RuleSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy TaxRule? @relation("RuleSupersession")

  approvedBy  String?
  approvedAt  DateTime?
  publishedAt DateTime?
  archivedAt  DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values    TaxRuleValue[]
  sources   TaxRuleSource[]
  conflicts RuleConflict[]

  brackets          TaxBracket[]
  withholdingTables WithholdingTable[]
  reciprocity       ReciprocityRule?
  localTax          LocalTaxRule?

  @@unique([ruleKey, version])
  @@index([taxYearId])
  @@index([jurisdictionId])
  @@index([category])
  @@index([status])
  @@index([ruleKey])
  @@index([effectiveFrom, effectiveTo])
  @@index([jurisdictionId, category, status])
}

/// One authoritative numeric or textual component of a rule.
///
/// WHY THIS TABLE EXISTS ALONGSIDE `TaxRule.payload`:
///   JSONB is right for irregular category-specific structure, but JSON numbers are IEEE-754
///   doubles — unacceptable for authoritative tax values (spec §4). Every value that must be
///   exact is stored here in PostgreSQL NUMERIC and read back through decimal.js.
///
/// PRECISION: NUMERIC(28,12) — 12 fractional digits carry rates such as 0.062 and any
/// published fractional rate without loss; the remaining 16 integer digits exceed any
/// realistic wage base or monetary threshold.
///
/// `numericValue` IS NULLABLE BY DESIGN. A source that does not state a value yields NULL
/// plus verificationStatus = NOT_STATED. It is never written as 0 (spec §19).
model TaxRuleValue {
  id        String  @id @default(cuid())
  taxRuleId String
  taxRule   TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  /// Component name, e.g. "employeeRate", "wageBase", "additionalMedicareThreshold".
  key       String
  valueType ValueType

  /// Groups related components, e.g. a filing status or a named bracket set.
  /// Empty string (not NULL) so the uniqueness constraint stays enforceable.
  groupKey String @default("")
  /// Ordering within a group, e.g. bracket index.
  ordinal  Int    @default(0)

  /// Exact authoritative number. NULL when not stated by the source.
  numericValue Decimal? @db.Decimal(28, 12)
  /// Non-numeric authoritative value (e.g. a method name).
  textValue    String?
  /// Unit or denomination, e.g. "USD", "fraction", "hours_per_week".
  unit         String?

  verificationStatus VerificationStatus @default(PENDING)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxRuleId, groupKey, ordinal, key])
  @@index([taxRuleId])
  @@index([key])
  @@index([verificationStatus])
}

/// Links a rule to an official source WITH a precise locator (spec §21).
///
/// Granular enough to answer: which rule, which version, which source, which page/table,
/// verified by whom and when.
model TaxRuleSource {
  id        String  @id @default(cuid())
  taxRuleId String
  taxRule   TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  sourceId  String
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  page       String?
  section    String?
  subsection String?
  table      String?
  heading    String?
  /// Full citation/locator string as an administrator would write it.
  citation   String?
  /// Verbatim excerpt supporting the value. Never paraphrased into a value.
  excerpt    String?

  verificationStatus VerificationStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxRuleId])
  @@index([sourceId])
  @@index([verificationStatus])
}

/// A recorded disagreement between sources about a rule (spec §24).
///
/// A conflict is represented, never silently resolved. An unresolved conflict blocks
/// activation — enforced in the domain layer and asserted by tests.
model RuleConflict {
  id        String  @id @default(cuid())
  taxRuleId String
  taxRule   TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  sourceAId String?
  sourceA   Source? @relation("ConflictSourceA", fields: [sourceAId], references: [id], onDelete: Restrict)
  sourceBId String?
  sourceB   Source? @relation("ConflictSourceB", fields: [sourceBId], references: [id], onDelete: Restrict)

  description     String
  status          ConflictStatus @default(OPEN)
  resolutionNotes String?
  resolvedBy      String?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxRuleId])
  @@index([status])
}

/// Append-only audit trail (spec §31). Audit records are never updated or deleted.
model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction

  /// Entity name, e.g. "TaxRule", and its primary key.
  entityType String
  entityId   String

  /// Who performed the action. Real identity arrives with authentication (Phase 8).
  actor  String
  reason String?

  oldValue Json?
  newValue Json?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ===========================================================================
// STRUCTURED RULE DETAIL TABLES
//
// DESIGN DECISION — why these hang off TaxRule rather than standing alone.
//
// Each table below carries ONLY the structure specific to its shape. Identity, versioning,
// effective dates, lifecycle status, verification, source links, conflicts and audit all come
// from the parent TaxRule. Duplicating those columns per detail table would create several
// parallel lifecycles that could disagree about which rule is in force — precisely the
// ambiguity the effective-date exclusion constraint exists to prevent.
//
// Consequence: a bracket set, a withholding table, a reciprocity agreement and a local tax
// are all published, superseded and audited through the single TaxRule workflow.
//
// EVERY authoritative numeric column here is NUMERIC(28,12) AND NULLABLE. A value the source
// does not state is NULL with a verification status — never 0 (spec §19).
// ===========================================================================

/// One bracket of a progressive schedule (spec §20).
///
/// Bounds are nullable: the lowest bracket may state no lower bound and the top bracket no
/// upper bound. `baseTax` is populated only where the official method explicitly states a
/// flat amount added before the marginal rate.
model TaxBracket {
  id        String  @id @default(cuid())
  taxRuleId String
  taxRule   TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  /// Filing status key. Free text, not an enum: filing statuses differ by jurisdiction and
  /// are jurisdiction data, not application constants (architecture rule 12).
  filingStatus String
  /// Position within the schedule, ascending.
  ordinal      Int

  lowerBound Decimal? @db.Decimal(28, 12)
  /// NULL means the top, open-ended bracket.
  upperBound Decimal? @db.Decimal(28, 12)
  rate       Decimal? @db.Decimal(28, 12)
  /// Flat amount added before the marginal rate, where the official method states one.
  baseTax    Decimal? @db.Decimal(28, 12)

  /// Optional narrower period than the parent rule, for mid-period schedule corrections.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  /// Direct trace to the exact document supporting this bracket, in addition to the
  /// rule-level sources.
  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  verificationStatus VerificationStatus @default(PENDING)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxRuleId, filingStatus, ordinal])
  @@index([taxRuleId])
  @@index([filingStatus])
  @@index([verificationStatus])
}

/// An official payroll withholding table (spec §20).
///
/// IMPORTANT: a withholding table is NOT a set of annual income-tax brackets. Spec §6 forbids
/// substituting one for the other, which is why this is a separate model from TaxBracket with
/// its own pay-frequency dimension.
model WithholdingTable {
  id        String  @id @default(cuid())
  taxRuleId String
  taxRule   TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  /// Identifier the official document gives the table, e.g. a table number or name.
  tableCode    String
  /// Withholding method the table belongs to (percentage method, wage bracket method, …).
  /// Free text: methods are named by each jurisdiction's own documentation.
  method       String
  filingStatus String
  payFrequency PayFrequency

  /// Per-allowance amount, where the method uses allowances.
  allowanceAmount Decimal? @db.Decimal(28, 12)

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  verificationStatus VerificationStatus @default(PENDING)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows WithholdingTableRow[]

  @@unique([taxRuleId, tableCode, filingStatus, payFrequency])
  @@index([taxRuleId])
  @@index([payFrequency])
  @@index([verificationStatus])
}

/// One wage row of a withholding table, preserved exactly as published.
model WithholdingTableRow {
  id                 String           @id @default(cuid())
  withholdingTableId String
  withholdingTable   WithholdingTable @relation(fields: [withholdingTableId], references: [id], onDelete: Cascade)

  /// Row position within the table, ascending by wage.
  ordinal Int

  wageFrom Decimal? @db.Decimal(28, 12)
  /// NULL means the top, open-ended row.
  wageTo   Decimal? @db.Decimal(28, 12)

  baseWithholding       Decimal? @db.Decimal(28, 12)
  percentage            Decimal? @db.Decimal(28, 12)
  adjustment            Decimal? @db.Decimal(28, 12)
  additionalWithholding Decimal? @db.Decimal(28, 12)

  verificationStatus VerificationStatus @default(PENDING)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([withholdingTableId, ordinal])
  @@index([withholdingTableId])
}

/// A reciprocity agreement between two states (spec §10).
///
/// One per TaxRule, so the agreement inherits that rule's lifecycle, effective dates, sources
/// and audit trail. Jurisdictions are referenced by FOREIGN KEY, never by state-name string —
/// spec §10 forbids inferring reciprocity from names.
model ReciprocityRule {
  id        String  @id @default(cuid())
  taxRuleId String  @unique
  taxRule   TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  /// State of residence.
  fromJurisdictionId String
  fromJurisdiction   Jurisdiction @relation("ReciprocityFrom", fields: [fromJurisdictionId], references: [id], onDelete: Restrict)
  /// State of work.
  toJurisdictionId   String
  toJurisdiction     Jurisdiction @relation("ReciprocityTo", fields: [toJurisdictionId], references: [id], onDelete: Restrict)

  /// How withholding is treated under the agreement, as stated by the source.
  withholdingTreatment String
  /// Certificate or exemption form the employee must file, where one is required.
  requiredForm         String?

  conditions Json?
  exceptions Json?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromJurisdictionId, toJurisdictionId, taxRuleId])
  @@index([fromJurisdictionId])
  @@index([toJurisdictionId])
}

/// A county, city, school district or other local tax (spec §9).
///
/// One per TaxRule. `localJurisdictionId` points at the specific local authority; its parent
/// chain (city -> county -> state) is walked through the Jurisdiction hierarchy.
///
/// A ZIP code is deliberately absent: a ZIP is at best an input aid to locality resolution,
/// never the legal taxing authority (spec §9).
model LocalTaxRule {
  id        String  @id @default(cuid())
  taxRuleId String  @unique
  taxRule   TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  localJurisdictionId String
  localJurisdiction   Jurisdiction @relation(fields: [localJurisdictionId], references: [id], onDelete: Restrict)

  /// Kind of local tax, e.g. an earned income tax or occupational privilege tax. Free text
  /// because local tax naming is jurisdiction-specific data.
  taxType String

  appliesToEmployee Boolean @default(true)
  appliesToEmployer Boolean @default(false)

  employeeRate Decimal? @db.Decimal(28, 12)
  employerRate Decimal? @db.Decimal(28, 12)
  wageBase     Decimal? @db.Decimal(28, 12)
  threshold    Decimal? @db.Decimal(28, 12)

  /// How residents and non-residents are treated, as stated by the source.
  residentTreatment    String?
  nonResidentTreatment String?

  conditions Json?
  exceptions Json?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([localJurisdictionId])
  @@index([taxType])
}

// ===========================================================================
// PHASE 3 — CALCULATION SNAPSHOT
// ===========================================================================

/// An immutable record of one calculation (spec §40).
///
/// PURPOSE: historical reproducibility. A report issued today must remain explainable after
/// the underlying tax rules change, so the snapshot stores the INPUT, the NORMALIZED input,
/// the RESULT, and the exact rule IDs/versions and source IDs that produced it — together
/// with the engine version, because methodology changes too.
///
/// The JSON columns hold engine output verbatim. Every monetary value inside them is an exact
/// decimal STRING, never a JSON number, so serialization cannot reintroduce IEEE-754 error
/// (spec §4).
///
/// Snapshots are append-only in practice: a recalculation creates a new row rather than
/// rewriting history.
model CalculationSnapshot {
  id String @id @default(cuid())

  /// Engine build that produced this result. Bumped when methodology changes.
  engineVersion String

  taxYear Int

  /// The instant the calculation applied to — decides which rule versions were in force.
  effectiveDate DateTime

  /// Jurisdiction codes the calculation resolved against.
  federalCode String
  stateCode   String?
  localCodes  String[]

  /// Overall calculation status (COMPLETE, INCOMPLETE, RULE_CONFLICT, …).
  status String

  /// Caller-supplied input, exactly as received.
  originalInput   Json
  /// Input after structural normalization.
  normalizedInput Json
  /// Full engine result, including the calculation trace.
  result          Json

  /// Rule identities and versions relied upon, denormalized so the snapshot stays
  /// reproducible even if a rule row is later superseded or archived.
  ruleReferences Json
  /// Official source IDs behind those rules.
  sourceIds      String[]

  /// PHASE 4 — the federal block (D-SNAP-1).
  ///
  /// Holds the RESOLVED federal rule DETAIL as it stood at calculation time — rates, wage
  /// bases, thresholds and schedule rows — not merely the rule IDs. Storing only IDs would
  /// make a historical result depend on rows that versioning is designed to change; with the
  /// detail embedded, publishing a later rule cannot move an old answer.
  ///
  /// Also carries the worksheet line-level intermediates, wage buckets, disclosures and the
  /// feature-flag values in force, which is what the Phase 8 Federal Rule Audit screen reads.
  ///
  /// NULL for snapshots taken before Phase 4, and for calculations with no federal component.
  federal Json?

  createdAt DateTime @default(now())

  @@index([taxYear])
  @@index([status])
  @@index([createdAt])
  @@index([engineVersion])
}

// ===========================================================================
// SEO-04 — SEO DATA MODEL (SEO-03 IMPLEMENTATION CONTRACT §D, §E, §AE)
//
// Six new models, four new enums. Nothing above this line is modified except the two
// additive back-relation fields on `Jurisdiction` and `TaxYear` (contract §AE, §AF) — no
// existing column, index, constraint or semantics changes.
//
// `TaxDataReadinessApproval` is owned by the TAX domain (contract §E, §W): it stores an
// OPERATIONAL APPROVAL DECISION, never a tax fact. It carries no rate, bracket, threshold,
// wage base, formula, verification truth or source record (§E.3). The SEO models below may
// never import `TaxRule` or read `TaxRule.verificationStatus` — they consume readiness only
// through the `coverage.isPublishable()` boundary (§F), implemented in `lib/tax/readiness/`.
// ===========================================================================

enum SeoPageTypeKey {
  HOME
  CALCULATOR
  STATE
  SALARY
  GUIDE
  HUB
  UTILITY
  // SALARY_STATE is deferred — not defined (SEO-01 §9, contract §T.2).
}

/// Independent from `RuleStatus`/`VerificationStatus`/`TaxYearStatus` — never reused across
/// domains, even where a token (`DRAFT`) is shared (contract §I.2).
enum SeoLifecycleState {
  DRAFT
  REVIEW
  VERIFIED
  PUBLISHED
  NEEDS_UPDATE
  ARCHIVED
}

/// Closed set. Adding a block type is a schema-registry change (`lib/seo/blocks/`), never a
/// free-form or arbitrary-HTML block (contract §D.7, §AB).
enum SeoBlockType {
  HERO
  INTRO
  RICH_TEXT
  KEY_FACTS
  CALCULATOR_EMBED
  CALCULATOR_CTA
  TAX_EXPLANATION
  STATE_TAX_SECTION
  NO_STATE_TAX_SECTION
  STATE_PROGRAM_SECTION
  LOCAL_TAX_NOTICE
  PAY_FREQUENCY_TABLE
  SALARY_TABLE
  SALARY_EXAMPLES
  EXAMPLE
  FAQ
  RELATED_CALCULATORS
  RELATED_STATES
  RELATED_SALARIES
  RELATED_GUIDES
  SOURCES
  CTA
  DISCLAIMER
}

/// Every forced-`noindex` case carries one of these, surfaced in a future admin (contract §J).
enum SeoIndexabilityReason {
  OK
  NOT_PUBLISHED
  QUALITY_GATE_FAILED
  TAX_READINESS_MISSING
  TAX_READINESS_STALE
  TAX_CAPABILITY_INSUFFICIENT
  CONTENT_STALE
  DUPLICATE_IDENTITY
  MANUAL_NOINDEX
  ARCHIVED
}

/// Global editable SEO content defaults — SINGLETON (contract §D.3).
///
/// `id` is a fixed key (`"singleton"`); a CHECK constraint added outside this file's
/// declarative reach (Prisma cannot express one — see the migration's own note, matching the
/// established Phase 2 convention) makes a second row impossible even via raw SQL.
///
/// Infrastructure (`NEXT_PUBLIC_SITE_URL`, hostname, environment, `trailingSlash`) is
/// deliberately NOT modeled here — it stays in `lib/config/env.ts` (contract §D.3, "§13").
/// The existing `SITE` constant (`lib/seo/metadata.ts`) remains the fallback layer beneath
/// this table: `SeoSettings value ?? SITE default`.
model SeoSettings {
  id String @id @default("singleton")

  siteName           String
  tagline            String
  defaultDescription String

  defaultOgImagePath String?
  defaultTwitterCard String?

  organizationName     String?
  organizationLogoPath String?
  organizationSameAs   String[]

  defaultRobotsIndex  Boolean @default(true)
  defaultRobotsFollow Boolean @default(true)

  /// Default token values (contract §G.3's fixed vocabulary only), Zod-validated on write.
  titleTokenDefaults Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Per-page-type editable defaults (contract §D.4). One row per `SeoPageTypeKey` member,
/// seeded at migration time — the enum gives type safety, this table gives no-code editing.
model SeoPageTypeConfig {
  id String @id @default(cuid())

  pageType SeoPageTypeKey @unique

  /// NULL ⇒ inherit from `SeoSettings` (contract §H.2).
  titleTemplate       String?
  descriptionTemplate String?
  h1Template          String?

  /// Per-type indexability posture (e.g. `UTILITY` = false).
  defaultIndexable Boolean @default(true)

  /// Ordered block types with required flags, Zod-validated on write.
  defaultBlockStructure Json?

  /// Constrained to the contract §O structured-data allowlist at the application layer.
  defaultStructuredDataTypes String[]

  defaultTemplateId String?
  defaultTemplate   SeoTemplate? @relation(fields: [defaultTemplateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Reusable metadata pattern + default block structure for one page type (contract §D.5).
/// Several templates may serve one page type (e.g. an income-tax vs. no-income-tax state
/// template); `isDefaultForType` picks the one used when a page sets no explicit template.
model SeoTemplate {
  id  String @id @default(cuid())
  key String @unique

  name        String
  description String

  pageType SeoPageTypeKey

  /// NULL ⇒ inherit from `SeoPageTypeConfig` (contract §H.2).
  titleTemplate       String?
  descriptionTemplate String?
  h1Template          String?

  /// Counts and selection rules for internal linking (contract §Q), Zod-validated on write.
  internalLinkRules Json?

  /// Partial-unique "one default per pageType" is enforced outside Prisma's declarative
  /// reach — see the migration's data-integrity section, mirroring `TaxYear_single_current`.
  isDefaultForType Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages            SeoPage[]
  pageTypeDefaults SeoPageTypeConfig[]
  blocks           SeoBlock[]

  @@index([pageType])
  @@index([isDefaultForType])
}

/// One addressable page (contract §D.6).
///
/// `path` is the sole duplicate-identity guard — global unique. The four identity fields
/// below (`jurisdictionId`, `salaryAmount`, `calculatorKey`, `guideSlug`) are each required
/// only for their own `pageType`; the per-type partial-unique constraints that enforce
/// "required when" live in the migration's data-integrity section (Prisma cannot express a
/// conditional NOT NULL or a partial unique declaratively).
model SeoPage {
  id String @id @default(cuid())

  pageType SeoPageTypeKey

  /// Canonical path, trailing-slash convention. Global unique — the duplicate-URL guard.
  path String @unique

  templateId String?
  template   SeoTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  /// Required when `pageType = STATE`. Sole jurisdiction identity (contract §C, §H) — no
  /// `SeoJurisdiction` table exists or may be added.
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)

  /// Required when `pageType = SALARY`. Integer only — one representation (contract §T).
  salaryAmount Int?

  /// Required when `pageType = CALCULATOR`. Stable identity.
  calculatorKey String?

  /// Required when `pageType = GUIDE`.
  guideSlug String?

  lifecycleState SeoLifecycleState @default(DRAFT)

  /// Editor intent only — NEVER the final indexability answer (contract §J.1).
  manualIndexable Boolean @default(false)

  /// NULL = inherit, `''` = explicit suppress, any other value = override (contract §H.2).
  /// Whitespace-only is normalized to `''` before it reaches this column.
  titleOverride       String?
  descriptionOverride String?
  h1Override          String?
  ogImagePathOverride String?

  /// Exception path only. A non-null value requires `canonicalOverrideReason` — enforced at
  /// the application layer and re-checked by the quality gates (contract §K).
  canonicalOverride       String?
  canonicalOverrideReason String?

  /// Drives staleness detection against the current tax year (contract §U). Never part of a
  /// public URL.
  contentYear Int?

  /// Existing Phase 5 `StateCapability` vocabulary only — no second vocabulary (contract §S.2).
  requiredCapabilities String[]

  /// Precomputed internal-link targets (contract §Q.2). Never resolved by an unbounded
  /// runtime query.
  relatedLinksCache Json?

  lastReviewedAt DateTime?
  publishedAt    DateTime?
  archivedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks SeoBlock[]

  @@index([pageType, lifecycleState])
  @@index([lifecycleState])
  @@index([jurisdictionId])
  @@index([salaryAmount])
  @@index([contentYear])
}

/// Ordered typed content block, on a page OR a template — never both (contract §D.7).
///
/// TYPED JSON, NOT EAV (§43): one row per BLOCK, with a discriminated `payload` validated by
/// a Zod schema selected by `blockType` — the same pattern already proven by `TaxRule.payload`
/// plus the state detail-schema registry. Adding a block type adds a schema, never a column
/// and never a migration.
model SeoBlock {
  id String @id @default(cuid())

  /// Exactly one of `pageId`/`templateId` is ever set — enforced by a CHECK constraint the
  /// migration adds beyond Prisma's declarative reach (`SeoBlock_exactly_one_parent`).
  pageId String?
  page   SeoPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  templateId String?
  template   SeoTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  blockType SeoBlockType
  position  Int

  /// Typed per `blockType`, Zod-validated on write (`lib/seo/blocks/`) — never EAV, never an
  /// arbitrary-HTML block.
  payload Json

  /// `DISCLAIMER` and (where the jurisdiction has local taxes) `LOCAL_TAX_NOTICE` are
  /// `isRemovable = false` — correctness controls, not copy (contract §S.3).
  isRequired  Boolean @default(false)
  isRemovable Boolean @default(true)

  /// e.g. render only if the jurisdiction has an income tax. Evaluated by the resolver, never
  /// an executable expression.
  condition Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, position])
  @@unique([templateId, position])
  @@index([blockType])
}

/// The persisted TAX-DOMAIN operational approval decision (contract §E.1) — never a stored
/// tax capability FACT (§E.3). SEO reads only the `coverage.isPublishable()` result derived
/// from the CURRENT (non-revoked, non-expired) row for a `(jurisdictionId, taxYearId)` pair;
/// it never reads this table directly.
///
/// Rows are EFFECTIVELY IMMUTABLE — only the three revocation fields are ever written after
/// creation. A new approval is always a new row, so the audit trail (what was approved, by
/// whom, against what evidence, and when withdrawn) is never lost. Deletion is never
/// permitted, enforced by the migration's data-integrity section (mirroring `AuditLog`'s own
/// append-only trigger).
model TaxDataReadinessApproval {
  id String @id @default(cuid())

  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)

  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id], onDelete: Restrict)

  /// Approved capability set, from the existing Phase 5 `StateCapability` vocabulary — no
  /// second vocabulary.
  capabilities String[]

  /// Opaque to SEO — never parsed or compared outside the tax domain. Deterministic and
  /// order-independent over the evidence set; changes when any constituent (rule version,
  /// verification state, relevant dataset generation) changes (contract §E.2).
  evidenceFingerprint String

  approvedByUserId String
  approvedAt       DateTime @default(now())

  /// Required — why approval was granted. Never blank.
  reason String

  expiresAt DateTime?

  revokedAt        DateTime?
  revokedByUserId  String?
  revocationReason String?

  createdAt DateTime @default(now())

  @@index([jurisdictionId, taxYearId, approvedAt(sort: Desc)])
  @@index([revokedAt])
}
