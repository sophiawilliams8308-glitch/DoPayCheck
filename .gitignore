# ---------------------------------------------------------------------------
# DoPayCheck — .gitignore
#
# NOTE: docs/SPECIFICATION.md and CLAUDE.md are authoritative project files and
# must NEVER be ignored. Do not add rules that would exclude them.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Test / coverage output.
# ANCHORED to the repository root on purpose: an unanchored `coverage/` matches
# any directory of that name at any depth, which silently excluded the Phase 5
# state coverage model at lib/tax/state/coverage/ from being committed.
/coverage/
.vitest/
test-results/
playwright-report/

# Secrets and environment (NEVER commit real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
secrets.json
# .env.example IS committed — it contains placeholders only.
!.env.example

# Local database artifacts
*.sqlite
*.sqlite3
*.db
pgdata/
docker-volumes/

# Prisma generated client (regenerated via `npm run db:generate`)
lib/db/generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Caches
.cache/
.eslintcache
.turbo/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# Deployment artifacts (Phase 12)
/deploy/
