# ---------------------------------------------------------------------------
# DoPayCheck — Example environment configuration
#
# Copy this file to `.env` and fill in real values for LOCAL DEVELOPMENT ONLY.
#
#   cp .env.example .env
#
# PLACEHOLDERS ONLY. Never commit a real `.env`, real credentials, real API
# keys, real database passwords or production secrets to this repository.
# `.env` is git-ignored; `.env.example` is committed.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Required in production. Optional in development/test until a database is
# provisioned — the app boots without it, but /api/health/db will report
# "unconfigured".
DATABASE_URL=postgresql://dopaycheck:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/dopaycheck?schema=public

# ---------------------------------------------------------------------------
# Site / SEO
# ---------------------------------------------------------------------------
# Canonical public base URL, no trailing slash. Used for canonical tags,
# Open Graph URLs, robots.txt and sitemap.xml generation (spec §37).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# One of: debug | info | warn | error
LOG_LEVEL=info
